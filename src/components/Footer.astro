---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const email = "chat2roz@outlook.com";
const linkedinUrl = "https://www.linkedin.com/in/roslynlau";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-name">Roslyn Lau</p>
      <p class="footer-positioning">
        Product, transformation and AI work for complex organisations.
      </p>
      <p class="footer-location">Melbourne, Australia</p>
    </div>

    <div>
      <p class="footer-heading">Explore</p>
      <nav aria-label="Footer navigation">
        <a href={base}>Home</a>
        <a href={`${base}work/`}>Work</a>
        <a href={`${base}about/`}>About</a>
        
      </nav>
    </div>

    <div>
      <p class="footer-heading">Connect</p>
      <a href={`mailto:${email}`}>{email}</a>
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
    </div>
  </div>

  <div class="container footer-meta">
    <p>© {year} Roslyn Lau. All rights reserved.</p>
    <p>Case studies are presented in NDA compliant form.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-12);
    background: var(--colour-surface);
    border-top: 1px solid var(--colour-border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .footer-name,
  .footer-heading {
    margin: 0 0 var(--space-3);
    font-weight: 800;
  }

  .footer-positioning,
  .footer-location {
    max-width: 26rem;
    margin: 0 0 var(--space-2);
    color: var(--colour-muted);
  }

  nav,
  .footer-grid > div:last-child {
    display: grid;
    gap: var(--space-2);
  }

  a {
    width: fit-content;
    color: var(--colour-muted);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--colour-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--colour-border);
    color: var(--colour-muted);
    font-size: 0.85rem;
  }

  .footer-meta p {
    margin: 0;
  }

  @media (max-width: 42rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>