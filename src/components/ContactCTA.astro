---
interface Props {
  title?: string;
  intro?: string;
  email?: string;
  linkedinUrl?: string;
}

const {
  title = "Let’s talk about what needs to change.",
  intro = "I’m interested in product, transformation and AI workflow opportunities where clearer thinking, aligned teams and practical delivery matter.",
  email = "chat2roz@outlook.com",
  linkedinUrl = "https://www.linkedin.com/in/roslynlau/",
} = Astro.props;
---

<section class="contact-cta" aria-labelledby="contact-cta-title">
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-cta-title">{title}</h2>
    <p>{intro}</p>

    <div class="actions">
      <a class="button button-primary" href={`mailto:${email}`}>
        Email me
      </a>
      <a
        class="button button-secondary"
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Connect on LinkedIn
      </a>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    padding-block: calc(var(--space-16) + 24px);
    background: transparent;
    color: var(--gray-0);
  }

  .eyebrow {
    color: var(--gray-300);
  }

  h2 {
    max-width: 42rem;
    margin: var(--space-2) 0 var(--space-4);
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--gray-0);
  }

  p:not(.eyebrow) {
    max-width: 42rem;
    margin: 0;
    color: var(--gray-200);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.7rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-weight: 750;
    text-decoration: none;
  }

  .button-primary {
    background: var(--colour-accent);
    color: var(--colour-paper);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--colour-accent-strong, var(--accent-dark));
  }

  .button-secondary {
    border-color: var(--colour-border);
    color: var(--colour-ink);
    background: var(--colour-paper);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    border-color: var(--colour-accent);
    color: var(--colour-accent);
  }

  @media (max-width: 42rem) {
    .contact-cta {
      padding-block: calc(var(--space-12) + 24px);
    }
  }
</style>