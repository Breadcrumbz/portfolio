---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/withBase';

const projects = (await getCollection('work'))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Work | Roslyn Lau"
	description="Selected product, transformation and AI work."
>
	<section class="section">
		<div class="container">
			<p class="eyebrow">Selected work</p>
			<h1>Work</h1>

			<p class="intro">
				A selection of product, transformation and AI engagements. Each case study focuses on
				the problem, approach, decisions and outcome.
			</p>

			{
				projects.length > 0 ? (
					<div class="work-grid">
						{projects.map((entry) => (
							<ProjectCard
								title={entry.data.title}
								summary={entry.data.summary}
								role={entry.data.role}
								sector={entry.data.sector}
								outcome={entry.data.outcome}
								tags={entry.data.tags}
								href={withBase(`/work/${entry.id}/`)}
							/>
						))}
					</div>
				) : (
					<p class="empty-state">
						Case studies are currently being prepared. Please check back soon.
					</p>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	h1 {
		margin: var(--space-2) 0 var(--space-4);
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 48rem;
		margin: 0;
		color: var(--colour-muted);
		font-size: 1.125rem;
		line-height: 1.65;
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-6);
		margin-top: var(--space-12);
	}

	.empty-state {
		margin-top: var(--space-8);
		color: var(--colour-muted);
	}

	@media (max-width: 44rem) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
