---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import CaseStudyHero from "../../components/CaseStudyHero.astro";
import OutcomePanel from "../../components/OutcomePanel.astro";
import ContactCTA from "../../components/ContactCTA.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");

  return work
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Layout title={data.title} description={data.summary}>
  <CaseStudyHero
    title={data.title}
    summary={data.summary}
    role={data.role}
    clientType={data.clientType}
    sector={data.sector}
    year={data.year}
    tags={data.tags}
    outcome={data.outcome}
    confidentiality={data.confidentiality}
    heroImage={data.heroImage}
  />

  <article class="case-study">
    <div class="container">
      <div class="case-study-content">
        <Content />
      </div>
    </div>
  </article>

  <div class="container">
    <OutcomePanel
      outcome={data.outcome}
      contribution={`Led the product and transformation approach for this ${data.sector.toLowerCase()} engagement.`}
    />
  </div>

  <ContactCTA
    title="Interested in the approach behind this work?"
    intro="Get in touch if you would like to discuss the decisions, constraints and delivery approach in more detail."
  />
</Layout>

<style>
  .case-study {
    padding-block: var(--space-16);
  }

  .case-study-content {
    width: 100%;
    padding-inline-start: var(--space-8);
    box-sizing: border-box;
  }

  .case-study-content :global(h2) {
    margin: var(--space-12) 0 var(--space-4);
    font-size: clamp(1.6rem, 3vw, 2.35rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .case-study-content :global(h2:first-child) {
    margin-top: 0;
  }

  .case-study-content :global(h3) {
    margin: var(--space-8) 0 var(--space-3);
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .case-study-content :global(p),
  .case-study-content :global(li) {
    color: var(--colour-ink);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .case-study-content :global(p) {
    margin-block: 0 var(--space-5);
  }

  .case-study-content :global(ul),
  .case-study-content :global(ol) {
    margin: 0 0 var(--space-6);
    padding-left: 1.35rem;
  }

  .case-study-content :global(li + li) {
    margin-top: var(--space-2);
  }

  .case-study-content :global(a) {
    color: var(--colour-accent);
    font-weight: 650;
    text-underline-offset: 0.18em;
  }

  .case-study-content :global(blockquote) {
    margin: var(--space-8) 0;
    padding-left: var(--space-6);
    border-left: 0.25rem solid var(--colour-accent);
    color: var(--colour-muted);
    font-size: 1.125rem;
  }

  .case-study-content :global(img) {
    width: 100%;
    height: auto;
    margin-block: var(--space-8);
    border: 1px solid var(--colour-border);
  }

  @media (max-width: 42rem) {
    .case-study {
      padding-block: var(--space-12);
    }
  }
  .case-study-content :global(table) {
  display: block;
  width: 100%;
  overflow-x: auto;
  margin-block: var(--space-8);
  border-collapse: collapse;
  border: 1px solid var(--colour-border);
  font-size: 0.92rem;
  line-height: 1.5;
}

.case-study-content :global(th),
.case-study-content :global(td) {
  min-width: 11rem;
  padding: 0.85rem;
  border: 1px solid var(--colour-border);
  text-align: left;
  vertical-align: top;
}

.case-study-content :global(th) {
  background: var(--colour-accent-soft);
  color: var(--colour-ink);
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.03em;
}

.case-study-content :global(tbody tr:nth-child(even)) {
  background: var(--colour-surface);
}
</style>