---
import { getCollection } from "astro:content";
import Layout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCTA from "../components/ContactCTA.astro";

const base = import.meta.env.BASE_URL;

const featuredWork = (await getCollection("work"))
  .filter((entry) => entry.data.featured && !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title=" Product, Transformation & AI | Roslyn Lau"
  description="Portfolio of product strategy, transformation, process design and AI workflow work."
>
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="eyebrow">Product · Transformation · AI</p>

          <h1>
            Turning complex operational and customer problems into practical
            product and transformation outcomes.
          </h1>

          <p class="hero-intro">
            I work with teams navigating ambiguity across customer experience,
            operations and technology. My approach brings together the people
            affected by change, the realities of how work gets done, and a
            credible path from decision to delivery.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href={`${base}work/`}>
              View selected work
            </a>

            <a class="button button-secondary" href={`${base}about/`}>
              About my approach
            </a>
          </div>
        </div>

        <aside class="hero-proof" aria-label="Core capabilities">
          <p class="eyebrow">What I do</p>

          <ul>
            <li>Product strategy and discovery</li>
            <li>Transformation and operating model design</li>
            <li>Service and process improvement</li>
            <li>Stakeholder alignment and delivery planning</li>
            <li>Practical AI workflow design</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <SectionHeading
          eyebrow="Selected work"
          title="Work that makes the path forward clearer."
          intro="A selection of product, transformation and AI engagements. Each case study focuses on the problem, the decisions that mattered, the approach taken and the outcome."
        />

        {
          featuredWork.length > 0 ? (
            <div class="work-grid">
              {featuredWork.map((entry) => (
                <ProjectCard
                  title={entry.data.title}
                  summary={entry.data.summary}
                  role={entry.data.role}
                  sector={entry.data.sector}
                  outcome={entry.data.outcome}
                  tags={entry.data.tags}
                  href={`${base}work/${entry.id}/`}
                />
              ))}
            </div>
          ) : (
            <div class="work-placeholder">
              <p>
                Selected case studies are currently being prepared. Please
                return soon to see enterprise product, transformation and AI
                workflow work.
              </p>
              <a href={`${base}work/`}>View all work</a>
            </div>
          )
        }

        {
          featuredWork.length > 0 && (
            <p class="section-link">
              <a href={`${base}work/`}>
                Explore all case studies <span aria-hidden="true">→</span>
              </a>
            </p>
          )
        }
      </div>
    </section>

    <section class="capabilities-section">
      <div class="container">
        <SectionHeading
          eyebrow="How I work"
          title="Make the right problem visible before committing to the solution."
          intro="Complex change rarely fails because teams lack ideas. It fails when the problem is unclear, decisions are fragmented, or the delivery path does not reflect operational reality."
        />

        <div class="capability-grid">
          <article>
            <p class="capability-number">01</p>
            <h3>Clarify the system</h3>
            <p>
              Build a shared view of the customer, operating and technology
              context through research, service mapping, process analysis and
              evidence-led framing.
            </p>
          </article>

          <article>
            <p class="capability-number">02</p>
            <h3>Align the decisions</h3>
            <p>
              Help cross-functional stakeholders surface trade-offs, prioritise
              what matters and move from competing assumptions to a practical
              direction.
            </p>
          </article>

          <article>
            <p class="capability-number">03</p>
            <h3>Design for delivery</h3>
            <p>
              Translate the target state into a credible roadmap, operating
              model, product direction or workflow that teams can implement and
              improve.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="evidence-section">
      <div class="container evidence-grid">
        <div>
          <p class="eyebrow">Experience</p>
          <h2>Comfortable in complex enterprise environments.</h2>
        </div>

        <div class="evidence-copy">
          <p>
            My work spans telecommunications, customer and channel operations,
            enterprise systems, sales enablement, data-informed decision-making
            and process transformation.
          </p>

          <p>
            I am most effective where teams need to connect strategic intent
            with the detail required to make change real: customer needs,
            workflows, technology dependencies, governance and delivery
            priorities.
          </p>
        </div>
      </div>
    </section>

    <ContactCTA
      title="Have a complex product or transformation challenge?"
      intro="I’m open to product, transformation, customer-experience and AI workflow opportunities where clearer thinking, aligned teams and practical delivery matter."
      email="your-email@example.com"
      linkedinUrl="https://www.linkedin.com/in/your-linkedin-profile/"
    />
  </main>
</Layout>

<style>
  .hero {
    padding-block: calc(var(--space-16) + 24px);
    background: var(--colour-surface);
    border-bottom: 1px solid var(--colour-border);
  }

  .section,
  .capabilities-section,
  .evidence-section {
    padding-block: calc(var(--space-16) + 24px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(17rem, 0.65fr);
    align-items: end;
    gap: var(--space-12);
  }

  h1 {
    max-width: 15ch;
    margin: var(--space-3) 0 var(--space-6);
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .hero-intro {
    max-width: 43rem;
    margin: 0;
    color: var(--colour-muted);
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.7rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-weight: 750;
    text-decoration: none;
  }

  .button-primary {
    background: var(--colour-accent);
    color: var(--colour-paper);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--colour-accent-strong);
  }

  .button-secondary {
    border-color: var(--colour-border);
    color: var(--colour-ink);
    background: var(--colour-paper);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    border-color: var(--colour-accent);
    color: var(--colour-accent);
  }

  .hero-proof {
    padding: var(--space-6);
    border: 1px solid var(--colour-border);
    background: var(--colour-paper);
  }

  .hero-proof ul {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-proof li {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-border);
    font-weight: 650;
    line-height: 1.4;
  }

  .hero-proof li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .work-placeholder {
    max-width: 42rem;
    padding: var(--space-6);
    border: 1px solid var(--colour-border);
    background: var(--colour-surface);
  }

  .work-placeholder p {
    margin-top: 0;
    color: var(--colour-muted);
  }

  .work-placeholder a,
  .section-link a {
    color: var(--colour-accent);
    font-weight: 750;
    text-decoration: none;
  }

  .section-link {
    margin: var(--space-8) 0 0;
  }

  .section-link a:hover,
  .section-link a:focus-visible,
  .work-placeholder a:hover,
  .work-placeholder a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .capabilities-section {
    background: transparent;
    color: var(--gray-0);
  }

  .capabilities-section :global(.eyebrow) {
    color: var(--gray-300);
  }

  .capabilities-section :global(h2) {
    color: var(--gray-0);
  }

  .capabilities-section :global(.intro) {
    color: var(--gray-200);
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  .capability-grid article {
    padding-top: var(--space-5);
    border-top: 1px solid var(--gray-700);
  }

  .capability-number {
    margin: 0;
    color: var(--gray-300);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .capability-grid h3 {
    margin: var(--space-4) 0 var(--space-3);
    font-size: 1.4rem;
    line-height: 1.25;
    color: var(--gray-0);
  }

  .capability-grid article > p:last-child {
    margin: 0;
    color: var(--gray-200);
    line-height: 1.65;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-12);
  }

  .evidence-grid h2 {
    max-width: 15ch;
    margin: var(--space-3) 0 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .evidence-copy {
    color: var(--colour-muted);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .evidence-copy p {
    margin: 0 0 var(--space-5);
  }

  .evidence-copy p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 58rem) {
    .hero-grid,
    .evidence-grid {
      grid-template-columns: 1fr;
    }

    .hero-proof {
      max-width: 42rem;
    }

    .work-grid,
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 42rem) {
    .hero,
    .section,
    .capabilities-section,
    .evidence-section {
      padding-block: calc(var(--space-12) + 24px);
    }

    h1 {
      max-width: 17ch;
    }
  }
</style>