---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Contact me."
>
  <section class="section">
    <div class="container wrapper">
      <p class="eyebrow">Contact</p>
       <h1>Let’s talk about what needs to change.</h1>
      
      <p class="intro">
        I am interested in product, transformation, customer-experience and AI
        workflow opportunities where clearer thinking, aligned teams and
        practical delivery matter.
      </p>

      <p>
        Whether you are shaping a new product direction, improving a complex
        operating process, aligning teams around a transformation roadmap, or
        exploring a responsible AI workflow, I'd be happy to connect.
      </p>
    </div>
  </section>

 <section class="section">
   <div class="container wrapper">
      <h2>Get in touch</h2>

      <p>
        <a href="mailto:chat2roz@outlook.com">
          chat2roz@outlook.com
        </a>
      </p>

      <p>
        <a
          href="https://www.linkedin.com/in/roslynlau/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Connect with me on LinkedIn
        </a>
      </p>
    </div>
  </section>

 <section class="section">
  <div class="container wrapper">
  <h2>Location</h2>

      <p>
        I am based in Melbourne, Australia, and open to local, hybrid
        and remote opportunities.
      </p>
    </div>
  </section>

 <section class="section">
   <div class="container wrapper">
  <p>
        For confidentiality reasons, some portfolio work is shown as
        anonymised, NDA-safe case studies. I can discuss my role, approach and
        relevant experience in more detail in conversation.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: var(--space-2) 0 var(--space-4);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 48rem;
    margin: 0;
    color: var(--colour-muted);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  h2 {
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
</style>
